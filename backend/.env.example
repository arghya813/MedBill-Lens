# ---------------------------------------------------------------------------
# MedBill Lens - backend environment
# Copy to `.env` and edit. NEVER commit the real `.env` or any API key.
#
# Every variable is prefixed with MEDBILL_ so it cannot collide with unrelated
# system or shell environment variables.
# ---------------------------------------------------------------------------

# --- AI provider ---------------------------------------------------------
# "demo"                          deterministic offline provider (default, no key)
# "openai" / "openai_compatible"  any OpenAI-compatible chat-completions API
MEDBILL_AI_PROVIDER=demo

# Leave blank to run fully offline. Required for a real provider.
MEDBILL_AI_API_KEY=

# Change for self-hosted / third-party OpenAI-compatible gateways.
MEDBILL_AI_BASE_URL=https://api.openai.com/v1
MEDBILL_AI_MODEL=gpt-4o-mini

# Optional: a separate vision model for scanned images / PDFs.
MEDBILL_AI_VISION_MODEL=

MEDBILL_AI_TIMEOUT_SECONDS=60
MEDBILL_AI_MAX_RETRIES=2
# When a real provider fails, fall back to the deterministic provider instead
# of failing the request. Recommended for demos. Set to false to surface
# provider outages honestly instead of substituting rule-based wording.
MEDBILL_AI_FALLBACK_TO_DEMO=true

# --- Database ------------------------------------------------------------
# SQLite for development. For PostgreSQL use, for example:
#   MEDBILL_DATABASE_URL=postgresql+psycopg://medbill:secret@localhost:5432/medbill
MEDBILL_DATABASE_URL=sqlite:///./medbill.db
MEDBILL_SQL_ECHO=false

# --- App -----------------------------------------------------------------
MEDBILL_ENVIRONMENT=development
MEDBILL_DEBUG=false
MEDBILL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads & privacy ---------------------------------------------------
MEDBILL_MAX_UPLOAD_SIZE_MB=10
# Raw uploaded documents (and their extracted text) are deleted after this.
MEDBILL_RAW_FILE_RETENTION_MINUTES=30
# Leave empty for ./data/uploads. Never point this at a publicly served path.
MEDBILL_STORAGE_DIR=
# Raw documents are never served over HTTP. Do not enable.
MEDBILL_SERVE_RAW_FILES=false
MEDBILL_ANONYMIZE_REPORTS_BY_DEFAULT=true

# --- Demo mode -----------------------------------------------------------
MEDBILL_DEMO_MODE=true
MEDBILL_SEED_DEMO_BENCHMARKS=true

# --- Rate limiting -------------------------------------------------------
MEDBILL_RATE_LIMIT_ENABLED=true
MEDBILL_RATE_LIMIT_REQUESTS=60
MEDBILL_RATE_LIMIT_WINDOW_SECONDS=60

# --- Authentication (architecture stub, off by default) ------------------
MEDBILL_AUTH_ENABLED=false
MEDBILL_API_KEY_HEADER=X-API-Key
MEDBILL_API_KEY=

# --- Flagging thresholds (percent above the benchmark maximum) ------------
# Deterministic and configurable. AI never decides these.
MEDBILL_FLAG_WITHIN_TOLERANCE_PCT=0
MEDBILL_FLAG_REVIEW_PCT=10
MEDBILL_FLAG_ATTENTION_PCT=25
MEDBILL_BENCHMARK_MIN_RECORDS=1
MEDBILL_MIN_SIGNIFICANT_DIFFERENCE=100

# --- Benchmark matching --------------------------------------------------
MEDBILL_BENCHMARK_REQUIRE_CITY_MATCH=true
MEDBILL_BENCHMARK_REQUIRE_CATEGORY_MATCH=true
MEDBILL_BENCHMARK_CITY_TIER_FALLBACK=true
MEDBILL_BENCHMARK_SERVICE_SIMILARITY_THRESHOLD=0.55
MEDBILL_BENCHMARK_MATCH_TREATMENT=true

# --- Locale --------------------------------------------------------------
MEDBILL_CURRENCY_SYMBOL=₹
MEDBILL_CURRENCY_CODE=INR
MEDBILL_LOCALE=en-IN
