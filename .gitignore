# --- Runtime data ---------------------------------------------------------
# Sample documents and uploaded files are generated on first run.
# The benchmark datasets under `backend/data/` ARE source: `demo_benchmarks.json`
# is the synthetic placeholder set, `cghs_benchmarks.json` is the published CGHS
# tariff built by `backend/scripts/import_cghs.py`, and `cghs_rates.json` is that
# script's cached copy of the official rate API.
backend/data/sample_bills/
backend/data/uploads/
backend/medbill.db
backend/medbill.db-journal
*.sqlite
*.sqlite3

# Uploaded documents. Must never be committed.
uploads/
storage/

