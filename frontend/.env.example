# ---------------------------------------------------------------------------
# MedBill Lens - frontend environment
#
# Copy to `.env.local` to override. Everything here is optional: with no
# configuration the dev server proxies `/api` to http://127.0.0.1:8000 and the
# app talks to the backend on the same origin as the page.
# ---------------------------------------------------------------------------

# Absolute API origin. Set this only when the API is on a different origin, for
# example in production. It must then be listed in the backend's
# MEDBILL_CORS_ORIGINS.
# VITE_API_BASE_URL=https://api.example.com

# Backend origin the dev server proxies /api to. Change if the backend runs on
# another host or port.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Note: never put an AI provider key in this file. Vite exposes any VITE_*
# variable to the browser. Provider credentials belong in the backend .env.
