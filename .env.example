# ---------------------------------------------------------------------------
# MedBill Lens - environment template
#
# Backend variables live in `backend/.env` (see `backend/.env.example`).
# This file documents the whole surface so there is one place to look.
#
# EVERYTHING IS OPTIONAL. With no configuration at all the server runs in demo
# mode: the built-in engine reads text PDFs and a synthetic benchmark dataset is
# seeded on first run. No API key is needed to use the product.
# ---------------------------------------------------------------------------

# --- Backend: AI provider -------------------------------------------------
# "demo" (default)  deterministic offline engine, no key required
# "openai" / "openai_compatible"  any OpenAI-compatible chat-completions API
#
# A key only upgrades the written explanations and question generation from
# templated to generated. Every number, range and flag is produced by the
# deterministic analysis engine either way.
MEDBILL_AI_PROVIDER=demo
MEDBILL_AI_API_KEY=
MEDBILL_AI_BASE_URL=https://api.openai.com/v1
MEDBILL_AI_MODEL=gpt-4o-mini

# Separate vision model for scanned documents. Blank reuses the main model.
MEDBILL_AI_VISION_MODEL=

# Fall back to the demo engine if the real provider fails, instead of returning
# an error. Recommended for demos and small deployments.
MEDBILL_AI_FALLBACK_TO_DEMO=true

# --- Backend: database ----------------------------------------------------
# SQLite for development:
MEDBILL_DATABASE_URL=sqlite:///./medbill.db
# PostgreSQL for anything shared or deployed:
# MEDBILL_DATABASE_URL=postgresql+psycopg://medbill:secret@localhost:5432/medbill
MEDBILL_SQL_ECHO=false

# --- Backend: app ---------------------------------------------------------
MEDBILL_ENVIRONMENT=development
MEDBILL_DEBUG=false
# Comma-separated allowed origins. Add your deployed frontend URL here.
MEDBILL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Backend: uploads and privacy ----------------------------------------
MEDBILL_MAX_UPLOAD_SIZE_MB=10

# Raw documents and their extracted text are deleted after this window. This is
# a privacy control, not a storage strategy. Keep it short.
MEDBILL_RAW_FILE_RETENTION_MINUTES=30

# Where raw documents are written. Never point this at a publicly served path.
MEDBILL_STORAGE_DIR=

# Raw documents are never served over HTTP. Do not enable.
MEDBILL_SERVE_RAW_FILES=false

MEDBILL_ANONYMIZE_REPORTS_BY_DEFAULT=true

# --- Backend: demo mode ---------------------------------------------------
# Synthetic scenarios and sample bills. Turn off for a production deployment.
MEDBILL_DEMO_MODE=true
MEDBILL_SEED_DEMO_BENCHMARKS=true

# --- Backend: rate limiting and auth --------------------------------------
MEDBILL_RATE_LIMIT_ENABLED=true
MEDBILL_RATE_LIMIT_REQUESTS=60
MEDBILL_RATE_LIMIT_WINDOW_SECONDS=60

# Architecture stub, off by default. When on, write endpoints require the key.
MEDBILL_AUTH_ENABLED=false
MEDBILL_API_KEY_HEADER=X-API-Key
MEDBILL_API_KEY=

# --- Backend: flagging thresholds -----------------------------------------
# Deterministic and configurable. The AI never decides a flag.
MEDBILL_FLAG_WITHIN_TOLERANCE_PCT=0
MEDBILL_FLAG_REVIEW_PCT=10
MEDBILL_FLAG_ATTENTION_PCT=25
MEDBILL_BENCHMARK_MIN_RECORDS=1
MEDBILL_MIN_SIGNIFICANT_DIFFERENCE=100

# --- Backend: benchmark matching ------------------------------------------
MEDBILL_BENCHMARK_REQUIRE_CITY_MATCH=true
MEDBILL_BENCHMARK_REQUIRE_CATEGORY_MATCH=true
MEDBILL_BENCHMARK_CITY_TIER_FALLBACK=true
MEDBILL_BENCHMARK_SERVICE_SIMILARITY_THRESHOLD=0.55
MEDBILL_BENCHMARK_MATCH_TREATMENT=true

# --- Backend: locale ------------------------------------------------------
MEDBILL_CURRENCY_SYMBOL=₹
MEDBILL_CURRENCY_CODE=INR
MEDBILL_LOCALE=en-IN

# --- Frontend (frontend/.env, all optional) -------------------------------
# Absolute API origin. Leave unset in development: Vite proxies /api to the
# backend, so a relative base works and no CORS configuration is needed.
# VITE_API_BASE_URL=https://api.example.com

# Backend origin the dev server proxies to. Defaults to http://127.0.0.1:8000
# VITE_PROXY_TARGET=http://127.0.0.1:8000
